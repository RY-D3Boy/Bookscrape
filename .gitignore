# ── Données générées à l'exécution ───────────────────────────────────────────
# Les dossiers sont trackés via .gitkeep, mais leur contenu est ignoré.

DATA/*
!DATA/.gitkeep

logs/*
!logs/.gitkeep

reference/*
!reference/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Environnements virtuels ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
